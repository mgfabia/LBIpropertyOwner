SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Database password — only needed for raw SQL (DDL, PostGIS) via the pooler.
# Supabase Dashboard > Project Settings > Database > Database password.
# This is the DB password, NOT the service-role key above.
SUPABASE_DB_PASSWORD=

# Optional. Auto-detected on first connect; set it afterwards to skip the probe.
# e.g. us-east-1
SUPABASE_DB_REGION=
